# Copy to .env.local for development; set the same values in Vercel for production.

# --- App
APP_URL=http://localhost:3000                 # public URL (used in payment callbacks, rider links, invites)
CRON_SECRET=                                  # random string; protects /api/worker and /api/cron/*  (openssl rand -hex 32)
ENCRYPTION_KEY=                               # 32 random bytes, base64: encrypts channel tokens and Paystack keys (openssl rand -base64 32)

# --- Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...             # server only: webhooks, worker, cron

# --- Claude
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL_ROUTINE=claude-haiku-5-5             # everyday replies
AI_MODEL_HARD=claude-sonnet-5-5               # photos, complaints, tricky chats

# --- Meta (WhatsApp Cloud API + Instagram messaging)
META_APP_SECRET=                              # App settings > Basic > App secret (signs webhooks)
INSTAGRAM_APP_SECRET=                         # only if your Instagram app has its own secret; defaults to META_APP_SECRET
META_VERIFY_TOKEN=                            # any random string; paste the same value in the webhook settings
META_GRAPH_VERSION=v23.0

# Your own WhatsApp number for vendor alerts, daily summaries and vendor commands (CONFIRM 1042, PAUSE, ...).
PLATFORM_WA_PHONE_NUMBER_ID=
PLATFORM_WA_ACCESS_TOKEN=
PLATFORM_WA_ALERT_TEMPLATE=vendor_alert       # approved utility template with one body variable {{1}}
WA_FOLLOWUP_TEMPLATE=order_update             # approved utility template with one body variable, for order updates after 24h

# --- Paystack (optional platform fallback; vendors normally use their own key, set in the dashboard)
PAYSTACK_SECRET_KEY=
CUSTOMER_EMAIL_DOMAIN=customers.salespadi.ng  # Paystack needs an email; customers get <phone>@this-domain

# --- Google Sheets order sync (optional): a service account with the Sheets API enabled
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=           # paste with \n for newlines

# --- Voice notes (optional): any OpenAI-compatible /audio/transcriptions endpoint, e.g. a self-hosted Whisper
TRANSCRIPTION_URL=
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1

# --- Reporting
USD_NGN_RATE=1600                             # for showing AI costs in naira on the AI costs page
